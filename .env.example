# Copy to .env.local for local development. In production (Vercel), set these
# as Environment Variables in the project dashboard — never commit real values.

OPENAI_API_KEY=

# Optional — persistent per-IP rate limiting via Upstash Redis (free tier).
# Without these, the /api/chat endpoint falls back to an in-memory limit that
# resets on server restart / cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
